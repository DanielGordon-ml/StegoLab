{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Name a server-approved source root without returning its private path.",
  "properties": {
    "folders": {
      "items": {
        "type": "string"
      },
      "maxItems": 200,
      "title": "Folders",
      "type": "array"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "label",
    "folders"
  ],
  "title": "WorkspaceSource",
  "type": "object"
}
