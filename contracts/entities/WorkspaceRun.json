{
  "$defs": {
    "WorkspaceMetrics": {
      "additionalProperties": false,
      "description": "Keep image quality separate from authenticated message recovery.",
      "properties": {
        "exact_recovery_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact Recovery Rate"
        },
        "psnr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Psnr"
        },
        "psnr_sample_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Psnr Sample Count"
        },
        "ssim": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ssim"
        },
        "ssim_sample_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ssim Sample Count"
        },
        "trial_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trial Count"
        }
      },
      "required": [
        "exact_recovery_rate",
        "trial_count",
        "psnr",
        "psnr_sample_count",
        "ssim",
        "ssim_sample_count"
      ],
      "title": "WorkspaceMetrics",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Associate measured results with one immutable training invocation.",
  "properties": {
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "dataset_revision": {
      "title": "Dataset Revision",
      "type": "string"
    },
    "experiment_identifier": {
      "title": "Experiment Identifier",
      "type": "string"
    },
    "global_step": {
      "minimum": 0,
      "title": "Global Step",
      "type": "integer"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "metrics": {
      "$ref": "#/$defs/WorkspaceMetrics"
    },
    "status": {
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "experiment_identifier",
    "status",
    "global_step",
    "dataset_revision",
    "created_at",
    "metrics"
  ],
  "title": "WorkspaceRun",
  "type": "object"
}
