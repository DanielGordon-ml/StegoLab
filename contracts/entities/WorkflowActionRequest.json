{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Make retries of supported actions safe across browser reloads.",
  "properties": {
    "action": {
      "enum": [
        "stop",
        "cancel",
        "pause",
        "resume"
      ],
      "title": "Action",
      "type": "string"
    },
    "client_request_identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Client Request Identifier",
      "type": "string"
    }
  },
  "required": [
    "client_request_identifier",
    "action"
  ],
  "title": "WorkflowActionRequest",
  "type": "object"
}
