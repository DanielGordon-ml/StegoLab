{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Freeze the agreed development profile independently of a stop boundary.",
  "properties": {
    "architecture": {
      "const": "dense_cpu_v1",
      "default": "dense_cpu_v1",
      "title": "Architecture",
      "type": "string"
    },
    "checkpoint_interval_seconds": {
      "const": 300,
      "default": 300,
      "title": "Checkpoint Interval Seconds",
      "type": "integer"
    },
    "cpu_threads": {
      "default": 4,
      "maximum": 16,
      "minimum": 1,
      "title": "Cpu Threads",
      "type": "integer"
    },
    "crop_size": {
      "const": 256,
      "default": 256,
      "title": "Crop Size",
      "type": "integer"
    },
    "device": {
      "const": "cpu",
      "default": "cpu",
      "title": "Device",
      "type": "string"
    },
    "effective_batch_size": {
      "const": 4,
      "default": 4,
      "title": "Effective Batch Size",
      "type": "integer"
    },
    "image_loss_ramp_steps": {
      "const": 200,
      "default": 200,
      "title": "Image Loss Ramp Steps",
      "type": "integer"
    },
    "learning_rate": {
      "default": 0.0001,
      "maximum": 0.0001,
      "minimum": 0.0001,
      "title": "Learning Rate",
      "type": "number"
    },
    "maximum_image_loss_weight": {
      "default": 100.0,
      "maximum": 100.0,
      "minimum": 100.0,
      "title": "Maximum Image Loss Weight",
      "type": "number"
    },
    "physical_batch_size": {
      "const": 1,
      "default": 1,
      "title": "Physical Batch Size",
      "type": "integer"
    },
    "planned_optimizer_steps": {
      "const": 1000,
      "default": 1000,
      "title": "Planned Optimizer Steps",
      "type": "integer"
    },
    "seed": {
      "const": 0,
      "default": 0,
      "title": "Seed",
      "type": "integer"
    },
    "validation_interval_steps": {
      "const": 100,
      "default": 100,
      "title": "Validation Interval Steps",
      "type": "integer"
    }
  },
  "required": [
    "architecture",
    "seed",
    "device",
    "crop_size",
    "physical_batch_size",
    "effective_batch_size",
    "learning_rate",
    "planned_optimizer_steps",
    "image_loss_ramp_steps",
    "maximum_image_loss_weight",
    "checkpoint_interval_seconds",
    "validation_interval_steps",
    "cpu_threads"
  ],
  "title": "TrainingConfiguration",
  "type": "object"
}
