{
  "$defs": {
    "PilotCriticConfiguration": {
      "additionalProperties": false,
      "description": "Optional adversarial critic; off by default and never part of an export.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "hidden_channels": {
          "const": 32,
          "default": 32,
          "title": "Hidden Channels",
          "type": "integer"
        },
        "learning_rate": {
          "default": 0.0001,
          "maximum": 0.001,
          "minimum": 1e-05,
          "title": "Learning Rate",
          "type": "number"
        },
        "weight": {
          "default": 1.0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        },
        "weight_clip": {
          "default": 0.1,
          "maximum": 1.0,
          "minimum": 0.001,
          "title": "Weight Clip",
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "weight",
        "learning_rate",
        "weight_clip",
        "hidden_channels"
      ],
      "title": "PilotCriticConfiguration",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Freeze the numerical profile before the first optimizer update.",
  "properties": {
    "architecture": {
      "const": "dense_pilot_v1",
      "default": "dense_pilot_v1",
      "title": "Architecture",
      "type": "string"
    },
    "checkpoint_interval_seconds": {
      "const": 300,
      "default": 300,
      "title": "Checkpoint Interval Seconds",
      "type": "integer"
    },
    "cpu_threads": {
      "default": 4,
      "maximum": 16,
      "minimum": 1,
      "title": "Cpu Threads",
      "type": "integer"
    },
    "critic": {
      "$ref": "#/$defs/PilotCriticConfiguration"
    },
    "crop_size": {
      "const": 256,
      "default": 256,
      "title": "Crop Size",
      "type": "integer"
    },
    "device": {
      "default": "cpu",
      "enum": [
        "cpu",
        "cuda"
      ],
      "title": "Device",
      "type": "string"
    },
    "effective_batch_size": {
      "const": 16,
      "default": 16,
      "title": "Effective Batch Size",
      "type": "integer"
    },
    "learning_rate": {
      "default": 0.0001,
      "maximum": 0.0001,
      "minimum": 0.0001,
      "title": "Learning Rate",
      "type": "number"
    },
    "maximum_image_loss_weight": {
      "default": 100.0,
      "maximum": 100.0,
      "minimum": 100.0,
      "title": "Maximum Image Loss Weight",
      "type": "number"
    },
    "physical_batch_size": {
      "default": 4,
      "enum": [
        4,
        8
      ],
      "title": "Physical Batch Size",
      "type": "integer"
    },
    "planned_optimizer_steps": {
      "maximum": 100000000,
      "minimum": 1,
      "title": "Planned Optimizer Steps",
      "type": "integer"
    },
    "precision": {
      "const": "float32",
      "default": "float32",
      "title": "Precision",
      "type": "string"
    },
    "seed": {
      "default": 0,
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "validation_interval_steps": {
      "default": 100,
      "maximum": 100000,
      "minimum": 1,
      "title": "Validation Interval Steps",
      "type": "integer"
    }
  },
  "required": [
    "architecture",
    "device",
    "precision",
    "seed",
    "crop_size",
    "physical_batch_size",
    "effective_batch_size",
    "learning_rate",
    "planned_optimizer_steps",
    "maximum_image_loss_weight",
    "checkpoint_interval_seconds",
    "validation_interval_steps",
    "cpu_threads",
    "critic"
  ],
  "title": "PilotTrainingConfiguration",
  "type": "object"
}
