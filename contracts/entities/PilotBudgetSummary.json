{
  "$defs": {
    "PilotStageTotal": {
      "additionalProperties": false,
      "description": "Report one stage's allocation after transfers, its spending, and its rest.",
      "properties": {
        "allocated_seconds": {
          "minimum": 0,
          "title": "Allocated Seconds",
          "type": "number"
        },
        "consumed_seconds": {
          "minimum": 0,
          "title": "Consumed Seconds",
          "type": "number"
        },
        "remaining_seconds": {
          "minimum": 0,
          "title": "Remaining Seconds",
          "type": "number"
        },
        "stage": {
          "enum": [
            "setup",
            "baseline",
            "ablation",
            "evaluation"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "allocated_seconds",
        "consumed_seconds",
        "remaining_seconds"
      ],
      "title": "PilotStageTotal",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Expose read-only spending information without starting an instance session.",
  "properties": {
    "active_session_identifier": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Session Identifier"
    },
    "consumed_seconds": {
      "minimum": 0,
      "title": "Consumed Seconds",
      "type": "number"
    },
    "initialized": {
      "title": "Initialized",
      "type": "boolean"
    },
    "remaining_seconds": {
      "minimum": 0,
      "title": "Remaining Seconds",
      "type": "number"
    },
    "stage_totals": {
      "items": {
        "$ref": "#/$defs/PilotStageTotal"
      },
      "maxItems": 4,
      "title": "Stage Totals",
      "type": "array"
    },
    "total_seconds": {
      "const": 86400,
      "default": 86400,
      "title": "Total Seconds",
      "type": "integer"
    }
  },
  "required": [
    "initialized",
    "total_seconds",
    "consumed_seconds",
    "remaining_seconds",
    "active_session_identifier",
    "stage_totals"
  ],
  "title": "PilotBudgetSummary",
  "type": "object"
}
