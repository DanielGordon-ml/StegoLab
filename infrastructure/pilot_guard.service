[Unit]
Description=StegoLab independent instance deadline guard
After=network-online.target docker.service
RequiresMountsFor=/srv/stegolab

[Service]
Type=simple
User=root
WorkingDirectory=/opt/stegolab
EnvironmentFile=/etc/stegolab/pilot-session.env
ExecStart=/opt/stegolab-host/bin/python -m scripts.pilot_budget_guard --ledger /srv/stegolab/state/gpu_pilot --session ${STEGOLAB_SESSION_IDENTIFIER} --container stegolab-pilot --execute-host-stop
Restart=on-failure
RestartSec=1
UMask=0022
# Host-only service: application containers never receive a Docker socket.

[Install]
WantedBy=multi-user.target
